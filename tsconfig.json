{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#/*": ["src/*"],
      "@/*": ["lib/*"],
      "$/*": [".server/*"]
    },
    "lib": ["dom", "dom.iterable", "es2024"],
    "module": "preserve",
    "target": "es2022",
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["vite/client", "@react-router/node"],
    "rootDirs": [".", "./.react-router/types"],
  },
  "include": [
    ".react-router/types/**/*",
    "lib/**/*.ts",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./src/.server/**/*.ts",
    "./src/.server/**/*.tsx",
    "./.sst/platform/config.d.ts",
    "scripts/**/*.ts",
    "sst.config.ts",
    "sst-env.d.ts",
    ".env.d.ts",
    "vite.config.ts",
    ".server/**/*.ts", "test/setup-tests.ts",
  ],
  "exclude": ["./src/scripts/**/*"]
}
