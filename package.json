  "sideEffects": false,
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "format": "biome check --write src lib .server",
    "format-unsafe": "biome check --write-unsafe src",
    "lint": "biome check ./src",
    "prepare": "lefthook install",
    "dev": "react-router dev",
    "stage": "sst deploy --stage default",
    "ship": "sst deploy --stage production",
    "test": "vitest --run",
    "load-secrets": "bash scripts/load-secrets.sh"
  },
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
